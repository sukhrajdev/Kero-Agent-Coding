{
  "name": "Sukhraj-Backend-Dev",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  
  "features": {
    // Ensures the latest Node.js and TypeScript are available
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  // 1. Automate: Install Ollama, pull the model, and install NPM packages
  "postCreateCommand": "curl -fsSL https://ollama.com/install.sh | sh && ollama serve > ollama.log 2>&1 & sleep 5 && ollama pull llama3.2:1b && npm install",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },

  "forwardPorts": [3000, 11434],
  "portsAttributes": {
    "3000": { "label": "Node.js App" },
    "11434": { "label": "Ollama API" }
  }
}
